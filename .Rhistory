.groups = "drop"
)
ea_sample_summary <- ea_bio_means |>
dplyr::group_by(sample, light_umol) |>
dplyr::summarise(
mean_enrichment = mean(enrichment_permil, na.rm = TRUE),
sd_enrichment = if (sum(is.finite(enrichment_permil)) > 1) {
sd(enrichment_permil, na.rm = TRUE)
} else {
NA_real_
},
.groups = "drop"
)
ea_enrichment_fit <- lm(enrichment_permil ~ light_umol, data = ea_bio_means)
ea_enrichment_slope <- coef(ea_enrichment_fit)[["light_umol"]]
