library(dplyr)
library(ggplot2)
experiment_dir <- "C:/Users/annie/OneDrive - California Institute of Technology/sessions_lab/202509_ALS01_withisotidy/data/202609_tp_FAMES_GC-IRMS"
project_dir <- normalizePath(
file.path(experiment_dir, "..", ".."),
winslash = "/"
)
config_path <- file.path(experiment_dir, "experiment_config.yaml")
package_dir <- file.path(project_dir, "isotidy")
lab_config_dir <- file.path(project_dir, "..", "sessions_lab_isotidy_config")
gc_methods_path <- file.path(lab_config_dir, "gc_methods.yml")
# Load the local package source so this document uses the current pipeline code.
pkgload::load_all(package_dir, quiet = TRUE)
config <- load_IRMS_config(config_path, lab_config_dir)
raw_gc <- load_gc_data(config)
gc_selected_input_set <- yaml::read_yaml(config_path)$gc$selected_input_set
method_name <- config$processing$gc_method
isotope <- config$processing$isotope
external_standard_id <- config$gc_standards$external$sample_id
output_dir <- file.path(experiment_dir, config$output_dir)
cat("Experiment:", config$experiment_name, "\n")
cat("Selected GC input set:", gc_selected_input_set, "\n")
cat("GC method:", method_name, "\n")
cat("Isotope:", isotope, "\n")
cat("External standard:", external_standard_id, "\n")
cat("Imported peak rows:", nrow(raw_gc), "\n")
exclude <- c(
"Athena11759",
"Athena11760",
"Athena11763",
"Athena11764",
"Athena11770",
"Athena11771",
"Athena11772",
"Athena11750",
"Athena11789",
"Athena11790"
)
manual_exclusions <- data.frame(
analysis_no = exclude,
reason = "Manually excluded"
)
gc_result <- process_gc(
raw_df = raw_gc,
config = config,
gc_methods = gc_methods_path,
method_name = method_name,
external_standard_id = external_standard_id,
isotope = isotope,
exclude_measurements = manual_exclusions,
verbose = TRUE
)
# FAMES are methyl esters, so use the finite external-standard-corrected
# measurements here. The pipeline's AA/NACME-corrected final values are not
# available for this experiment. These remain apparent FAME values because
# this step does not remove the contribution of the added methyl carbon.
fames_visualization_data <- summarize_replicates(
data = gc_result$data,
peripheral = "GC",
config = config,
value_columns = "delta_value_external_corrected",
verbose = FALSE
)
gc_result$daily_offsets
fames_visualization_data
fames_processing_flow <- tibble::tibble(
stage = c(
"Assigned sample peaks with finite external correction",
"Rows in default pipeline visualization summary",
"Finite values in default pipeline final summary",
"Rows in apparent FAME visualization summary",
"Finite apparent FAME values"
),
rows = c(
sum(
grepl("^[A-Za-z]+[0-9]+-[0-9]+-[A-Za-z]+$", gc_result$data$sample_id) &
!is.na(gc_result$data$compound_id) &
is.finite(gc_result$data$delta_value_external_corrected)
),
nrow(gc_result$visualization_data),
sum(is.finite(gc_result$visualization_data$delta_value_final_mean)),
nrow(fames_visualization_data),
sum(is.finite(fames_visualization_data$delta_value_external_corrected_mean))
)
)
fames_processing_flow
gc_result$injection_offsets
gc_result$excluded_measurements
gc_result$unmatched_measurement_exclusions
gc_result$excluded_standard_injection_ids
gc_result$excluded_standard_compound_ids
gc_saved <- save_gc_results(
result = gc_result,
config = config,
output_dir = output_dir,
prefix = config$file_name,
verbose = TRUE
)
fames_apparent_visualization_path <- file.path(
output_dir,
paste0(config$file_name, "_gc_apparent_fames_visualization.csv")
)
write.csv(fames_visualization_data, fames_apparent_visualization_path,
row.names = FALSE)
gc_saved
fames_apparent_visualization_path
fames_compound_order <- c(
"C14M", "C16M", "C18M", "C18-4", "EPA-C20-5", "DHA-C22-6"
)
light_values <- c(Tp1 = 120, Tp2 = 60)
summarise_light_data <- function(data, value_col) {
data |>
mutate(
condition = paste0(
"Tp",
stringr::str_extract(biological_replicate, "[0-9]+")
),
sample_no = stringr::str_extract(biological_replicate, "[0-9]+$"),
light = unname(light_values[condition]),
value = .data[[value_col]]
) |>
filter(is.finite(value), is.finite(light), !is.na(compound_id)) |>
group_by(compound_id, condition, sample_no, light) |>
summarise(
n = n(),
mean = mean(value),
sd = if (n() > 1L) sd(value) else NA_real_,
.groups = "drop"
)
}
plot_fames_by_compound <- function(data, y_label, title,
show_slope = FALSE,
show_r2 = FALSE,
zero_line = FALSE) {
plot_data <- data |>
filter(is.finite(light), is.finite(mean), !is.na(compound_id)) |>
mutate(compound_id = factor(compound_id, levels = fames_compound_order)) |>
filter(!is.na(compound_id))
if (nrow(plot_data) == 0L) {
stop(
"No finite rows remain for '", title,
"'. See fames_processing_flow and fames_data_flow to locate the empty stage."
)
}
slope_candidates <- plot_data |>
group_by(compound_id) |>
filter(n_distinct(light) >= 2L) |>
ungroup()
if (nrow(slope_candidates) > 0L) {
slope_labels <- slope_candidates |>
group_by(compound_id) |>
group_modify(~ {
fit <- lm(mean ~ light, data = .x)
tibble::tibble(
slope = unname(coef(fit)[["light"]]),
r2 = summary(fit)$r.squared
)
}) |>
ungroup() |>
mutate(
label = paste0(
"slope = ", formatC(slope, digits = 3, format = "g"),
if (show_r2) paste0("\nR² = ", formatC(r2, digits = 2, format = "f")) else ""
)
)
} else {
slope_labels <- tibble::tibble(
compound_id = factor(character(), levels = fames_compound_order),
label = character()
)
}
dodge <- position_dodge(width = 1.8)
p <- ggplot(
plot_data,
aes(x = light, y = mean, group = sample_no)
)
if (zero_line) {
p <- p + geom_hline(yintercept = 0, color = "grey60", linewidth = 0.5)
}
p <- p +
geom_errorbar(
aes(ymin = mean - sd, ymax = mean + sd),
width = 1.08, position = dodge, na.rm = TRUE
) +
geom_point(size = 3, color = "black", position = dodge)
if (show_slope && nrow(slope_labels) > 0L) {
p <- p + geom_text(
data = slope_labels,
aes(label = label),
inherit.aes = FALSE,
x = -Inf, y = Inf, hjust = -0.1, vjust = 1.4,
size = 3.5, color = "black"
)
}
p +
scale_x_continuous(
breaks = c(60, 120),
expand = expansion(mult = 0.15)
) +
facet_wrap(~ compound_id, ncol = 3, scales = "free_y") +
labs(
x = expression("Light intensity (" * mu * "mol photons" ~ m^-2 ~ s^-1 * ")"),
y = y_label,
caption = "Biological n = 2 per light condition",
title = title
) +
theme_bw() +
theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
strip.background = element_rect(fill = "grey92")
)
}
fames_d13c_values <- fames_visualization_data |>
filter(
